<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Comparative Growth Intelligence</title><style>{{ css }}</style></head>
<body><main>
<div class="meta">Report C · X Account Intelligence & Algorithm Audit · generated {{ generated }}</div>
<h1>Comparative Growth Intelligence — {{ names|join(' vs ') }}</h1>
<div class="sub">Independent audits compared on normalised metrics. Metrics are never pooled across accounts.
Algorithm repository <a href="{{ repo_url }}/tree/{{ sha }}">xai-org/x-algorithm@{{ sha[:7] }}</a>.</div>

<h2>1. Normalised performance</h2>
<table><tr><th>Metric</th>{% for h in handles %}<th class="num">@{{ h }}</th>{% endfor %}</tr>
{% for key, label, f in rows %}<tr><td>{{ label }}</td>{% for h in handles %}<td class="num">{{ cmp.accounts[h][key]|fmt(f) }}</td>{% endfor %}</tr>{% endfor %}</table>
<ul class="meta">{% for n in cmp.notes %}<li>{{ n }}</li>{% endfor %}</ul>

<h2>2. Shared issues (supported for both)</h2>
<table><tr><th>Issue</th>{% for h in handles %}<th>@{{ h }}</th>{% endfor %}</tr>
{% for r in cmp.shared_issues %}<tr><td>{{ r.issue }}</td>{% for h in handles %}<td>{{ r.status[h] }}</td>{% endfor %}</tr>{% endfor %}</table>

<h2>3. Account-specific issues</h2>
<table><tr><th>Issue</th>{% for h in handles %}<th>@{{ h }}</th>{% endfor %}</tr>
{% for r in cmp.account_specific_issues %}<tr><td>{{ r.issue }}</td>{% for h in handles %}<td>{{ r.status[h] }}</td>{% endfor %}</tr>{% endfor %}</table>

<h2>4. Content approaches</h2>
<div class="cols">{% for h in handles %}<div><h3>@{{ h }} — strongest and weakest segments</h3>
<table><tr><th>Segment</th><th class="num">n</th><th class="num">Ratio</th></tr>
{% for s in seg[h] %}<tr><td>{{ s.feature }} = {{ s.level }}</td><td class="num">{{ s.n }}</td><td class="num">{{ s.ratio|r2 }}x</td></tr>{% endfor %}</table></div>{% endfor %}</div>

<h2>5. Commenting behaviour</h2>
<table><tr><th>Metric</th>{% for h in handles %}<th class="num">@{{ h }}</th>{% endfor %}</tr>
{% for key, label, f in comment_rows %}<tr><td>{{ label }}</td>{% for h in handles %}<td class="num">{{ cmp.accounts[h][key]|fmt(f) }}</td>{% endfor %}</tr>{% endfor %}</table>

<h2>6. Transferable vs account-specific strategies</h2>
{% if cmp.transferable %}<table><tr><th>From</th><th>To</th><th>Strategy</th><th>Basis</th></tr>
{% for t in cmp.transferable %}<tr><td>@{{ t["from"] }}</td><td>@{{ t.to }}</td><td>{{ t.strategy }}</td><td>{{ t.basis }}</td></tr>{% endfor %}</table>{% else %}<p>No strategy clears the transfer threshold.</p>{% endif %}
<p class="note">Transfer is proposed only where the receiving account's own data already shows the mechanism working (e.g. its own articles outperform). Copying a successful post from the other account is not expected to reproduce its performance.</p>

<h2>7. Top barriers side by side</h2>
<div class="cols">{% for h in handles %}<div><h3>@{{ h }}</h3><ol>{% for r in roots[h] %}<li>{{ r.issue }}</li>{% endfor %}</ol></div>{% endfor %}</div>
</main></body></html>
